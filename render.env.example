# Copy these KEYS into Render Environment Variables; replace every placeholder there.
# Do not paste this example unchanged or commit a filled-in copy.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=REPLACE_WITH_YOUR_AI_STUDIO_KEY
DEVICE_TRANSPORT=poll
EDITH_DEVICE_TOKEN=REUSE_YOUR_EXISTING_PRIVATE_DEVICE_TOKEN
EDITH_WEB_USER=edith
EDITH_WEB_PASSWORD=REUSE_YOUR_EXISTING_PRIVATE_WEB_PASSWORD
DATABASE_URL=REPLACE_WITH_THE_COMPLETE_NEON_POSTGRESQL_URL
