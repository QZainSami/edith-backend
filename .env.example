# ESP32 IP or base URL; blank works without hardware.
EDITH_IP=
DEVICE_TIMEOUT=3
# auto tries LM Studio; off uses fixed rules replies.
LMSTUDIO_MODE=auto
# Server origin only, without /v1.
LMSTUDIO_URL=http://127.0.0.1:1234
# Copy the exact ID from Check LM Studio or /v1/models.
LMSTUDIO_MODEL=
LMSTUDIO_TIMEOUT=90
# Only needed if authentication is enabled on your LM Studio server.
LMSTUDIO_API_KEY=

# local preserves LAN control; poll enables outward authenticated device polling.
DEVICE_TRANSPORT=local
EDITH_DEVICE_TOKEN=
EDITH_WEB_USER=
EDITH_WEB_PASSWORD=
# Optional persistent disk path. Default: data/device.sqlite3
# EDITH_STATE_DB=/var/data/device.sqlite3

# Model provider: lmstudio (default), gemini, or rules.
# Local LM Studio settings above are preserved unless you choose gemini/rules.
LLM_PROVIDER=lmstudio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional external PostgreSQL. Blank keeps the local SQLite database.
# Required on Render. Paste the complete private connection URL with its TLS parameters.
DATABASE_URL=
